import java.util.HashMap;
import java.util.Map;

class Solution {
    public boolean containsNearbyAlmostDuplicate(int[] nums, int indexDiff, int valueDiff) {
        if (nums == null || nums.length < 2 || indexDiff <= 0 || valueDiff < 0) {
            return false;
        }

        // Map stores the bucket ID as the key, and the actual number as the value
        Map<Long, Long> buckets = new HashMap<>();
        long w = (long) valueDiff + 1; // Width of each bucket

        for (int i = 0; i < nums.length; i++) {
            long current = (long) nums[i];
            long bucketId = getBucketId(current, w);

            // Case 1: An item already exists in the exact same bucket (difference is definitely <= valueDiff)
            if (buckets.containsKey(bucketId)) {
                return true;
            }

            // Case 2: Check the adjacent left bucket
            if (buckets.containsKey(bucketId - 1) && current - buckets.get(bucketId - 1) <= valueDiff) {
                return true;
            }

            // Case 3: Check the adjacent right bucket
            if (buckets.containsKey(bucketId + 1) && buckets.get(bucketId + 1) - current <= valueDiff) {
                return true;
            }

            // Put current item into its designated bucket
            buckets.put(bucketId, current);

            // Enforce sliding window size limit (indexDiff)
            if (i >= indexDiff) {
                long lastBucketId = getBucketId((long) nums[i - indexDiff], w);
                buckets.remove(lastBucketId);
            }
        }

        return false;
    }

    // Helper method to accurately calculate bucket IDs, handling negative numbers correctly
    private long getBucketId(long num, long width) {
        return num < 0 ? (num + 1) / width - 1 : num / width;
    }
}
