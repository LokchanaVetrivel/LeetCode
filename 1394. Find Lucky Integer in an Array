import java.util.Arrays;
class Solution {
    public int findLucky(int[] arr) {
        Arrays.sort(arr);
        int maxLucky = -1;
        int count = 1; 
        for (int i = 0; i < arr.length - 1; i++) {
            if (arr[i] == arr[i + 1]) {
                count++;
            } else {
                if (count == arr[i]) {
                    maxLucky = arr[i];
                }
                count = 1;
            }
        }
        if (count == arr[arr.length - 1]) {
            maxLucky = arr[arr.length - 1];
        }        
        return maxLucky;
    }
}
