class Solution {
    public void merge(int[] nums1, int m, int[] nums2, int n) {
        int newArray[]=new int[m+n];
        int index=0;
        for(int i=0;i<m;i++){
            newArray[index]=nums1[i];
            index++;
        }
        for (int i = 0; i < n; i++) {
            newArray[index] = nums2[i];
            index++;
        }
        Arrays.sort(newArray);
        for (int i = 0; i < nums1.length; i++) {
            nums1[i] = newArray[i];
        }
    }   
}
