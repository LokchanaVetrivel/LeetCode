#include <stdio.h>
#include <stdlib.h>
#include <stdbool.h>

int x[30];
int solution_count = 0;
char*** platforms_saved_solutions = NULL;

bool place(int k, int i) {
    for (int j = 1; j <= k - 1; j++) {
        if ((x[j] == i) || (abs(x[j] - i) == abs(j - k))) {
            return false;
        }
    }
    return true;
}

void printSolution(int n) {
    solution_count++;
    printf("Solution %d: Set = [", solution_count);
    for (int i = 1; i <= n; i++) {
        printf("%d%s", x[i], (i == n ? "" : ", "));
    }
    printf("]\n");
    for (int i = 1; i <= n; i++) {
        for (int j = 1; j <= n; j++) {
            if (x[i] == j) 
                printf(" Q ");
            else 
                printf(" . ");
        }
        printf("\n");
    }
    printf("---------------------------\n\n");

    platforms_saved_solutions = (char***)realloc(platforms_saved_solutions, solution_count * sizeof(char**));
    platforms_saved_solutions[solution_count - 1] = (char**)malloc(n * sizeof(char*));
    for (int i = 1; i <= n; i++) {
        platforms_saved_solutions[solution_count - 1][i - 1] = (char*)malloc((n + 1) * sizeof(char));
        for (int j = 1; j <= n; j++) {
            platforms_saved_solutions[solution_count - 1][i - 1][j - 1] = (x[i] == j) ? 'Q' : '.';
        }
        platforms_saved_solutions[solution_count - 1][i - 1][n] = '\0';
    }
}

void nqueens(int k, int n) {
    for (int i = 1; i <= n; i++) {
        if (place(k, i)) {
            x[k] = i; 
            if (k == n) {
                printSolution(n);
            } else {
                nqueens(k + 1, n);
            }
        }
    }
}

char*** solveNQueens(int n, int* returnSize, int** returnColumnSizes) {
    solution_count = 0;
    platforms_saved_solutions = NULL;
    
    nqueens(1, n); 
    
    *returnSize = solution_count;
    *returnColumnSizes = (int*)malloc(solution_count * sizeof(int));
    for (int i = 0; i < solution_count; i++) {
        (*returnColumnSizes)[i] = n;
    }
    
    return platforms_saved_solutions;
}
