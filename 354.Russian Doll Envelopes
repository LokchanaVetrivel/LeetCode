import java.util.Arrays;
class Solution {
    public int maxEnvelopes(int[][] envelopes) {
        if (envelopes == null || envelopes.length == 0) {
            return 0;
        }
        // 1. Sort by width ascending. If widths match, sort height descending.
        Arrays.sort(envelopes, (a, b) -> {
            if (a[0] == b[0]) {
                return b[1] - a[1];
            }
            return a[0] - b[0];
        });
        // 2. O(N log N) LIS using binary search
        int[] dp = new int[envelopes.length];
        int len = 0;
        for (int[] envelope : envelopes) {
            int height = envelope[1];
            // Find the insertion point of the current height
            int index = Arrays.binarySearch(dp, 0, len, height);
            // If the element is not found, binarySearch returns -(insertion point) - 1
            if (index < 0) {
                index = -(index + 1);
            }
            // Update the element at the insertion point
            dp[index] = height;
            // If it was appended to the end, increase the length of the LIS
            if (index == len) {
                len++;
            }
        }
        return len;
    }
}
