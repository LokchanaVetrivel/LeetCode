class Solution {
    public int maximumGap(int[] nums) {
        if(nums.length<=1){
            return 0;
        }
        Arrays.sort(nums);
        int[] ans = new int[nums.length - 1];
        for(int i=1;i< nums.length;i++){
            ans[i - 1] = nums[i] - nums[i - 1];
        }
        int maxVal = 0;
        for (int i = 0; i < ans.length; i++) {
            if (ans[i] > maxVal) {
                maxVal = ans[i];
            }
        }
        return maxVal;
    }
}
