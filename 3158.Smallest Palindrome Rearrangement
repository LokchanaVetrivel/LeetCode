import java.util.*;
import java.math.BigInteger;

class Solution {
    public String smallestPalindrome(String s, int k) { 
        int[] counts = new int[26];
        for (char c : s.toCharArray()) {
            counts[c - 'a']++;
        }

        int oddCount = 0;
        char oddChar = 0;
        StringBuilder halfChars = new StringBuilder();
        
        for (int i = 0; i < 26; i++) {
            if (counts[i] % 2 != 0) {
                oddCount++;
                oddChar = (char) (i + 'a');
            }
            for (int j = 0; j < counts[i] / 2; j++) {
                halfChars.append((char) (i + 'a'));
            }
        }

        if (oddCount > 1) return ""; 

        String halfPermutation = findKthPermutation(halfChars.toString(), BigInteger.valueOf(k));
        if (halfPermutation.equals("FAIL")) return "";

        String firstHalf = halfPermutation;
        String secondHalf = new StringBuilder(firstHalf).reverse().toString();
        
        if (oddCount == 1) {
            return firstHalf + oddChar + secondHalf;
        } else {
            return firstHalf + secondHalf;
        }
    }

    private String findKthPermutation(String str, BigInteger k) {
        int n = str.length();
        if (n == 0) {
            return k.equals(BigInteger.ONE) ? "" : "FAIL";
        }

        int[] freq = new int[26];
        for (char c : str.toCharArray()) {
            freq[c - 'a']++;
        }
        
        StringBuilder sb = new StringBuilder();
        k = k.subtract(BigInteger.ONE); // Convert to 0-indexed format

        // Step 1: Compute the baseline total permutations for the entire half string initially
        BigInteger totalCount = factorial(n);
        for (int f : freq) {
            if (f > 1) {
                totalCount = totalCount.divide(factorial(f));
            }
        }

        // Step 2: Build the string slot by slot using O(1) mathematical updates
        for (int i = 0; i < n; i++) {
            int remainingLength = n - i;
            char selectedChar = 0;

            for (int j = 0; j < 26; j++) {
                if (freq[j] > 0) {
                    // Quick O(1) incremental calculation formula:
                    // count = totalCount * freq[j] / remainingLength
                    BigInteger count = totalCount.multiply(BigInteger.valueOf(freq[j]))
                                                .divide(BigInteger.valueOf(remainingLength));
                    
                    if (k.compareTo(count) < 0) {
                        selectedChar = (char) (j + 'a');
                        freq[j]--;
                        // The selected path becomes our new baseline for the next index position
                        totalCount = count; 
                        break;
                    }
                    
                    k = k.subtract(count);
                }
            }

            if (selectedChar == 0) return "FAIL"; 
            sb.append(selectedChar);
        }
        return sb.toString();
    }

    private BigInteger factorial(int n) {
        BigInteger fact = BigInteger.ONE;
        for (int i = 2; i <= n; i++) {
            fact = fact.multiply(BigInteger.valueOf(i));
        }
        return fact;
    }
}
